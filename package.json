{
  "name": "atris-shot",
  "version": "1.0.1",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @atris-shot/desktop",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:landing": "npm run dev -w @atris-shot/landing",
    "dev:public": "npm run dev -w @atris-shot/public-server",
    "build": "npm run build -w @atris-shot/desktop",
    "build:landing": "npm run build -w @atris-shot/landing",
    "build:public": "npm run build -w @atris-shot/public-server",
    "build:tauri-export": "npm run build:tauri-export -w @atris-shot/desktop",
    "tauri:dev": "npm run tauri:dev -w @atris-shot/desktop",
    "tauri:build": "npm run tauri:build -w @atris-shot/desktop",
    "release:windows": "node scripts/release-windows.mjs",
    "test:runtime-boundary": "node scripts/test-runtime-boundary.mjs",
    "test:release-windows": "node scripts/test-release-windows.mjs",
    "test:settings": "node --experimental-strip-types scripts/test-settings-normalization.mjs",
    "test:release-proxy": "npm run test:release-proxy -w @atris-shot/public-server",
    "brand:generate": "node scripts/generate-brand-assets.mjs && npm run tauri -w @atris-shot/desktop -- icon src-tauri/icons/source-master.png && node scripts/sync-brand-icon-containers.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run typecheck && npm run test:runtime-boundary && npm run test:settings && npm run test:release-proxy && npm run test:release-windows && npm run build && npm run build:landing && npm run build:public"
  }
}
