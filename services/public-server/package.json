{
  "name": "@atris-shot/public-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:site": "npm run build -w @atris-shot/landing && node scripts/build-site.mjs",
    "build": "npm run build:site && tsc",
    "typecheck": "tsc --noEmit",
    "test:release-proxy": "tsx src/test-release-proxy.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
