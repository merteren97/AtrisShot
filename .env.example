# Shared Atris identity service used by the desktop application.
NEXT_PUBLIC_ATRIS_HUB_URL="http://127.0.0.1:3000"

# Public AtrisShot landing, download proxy, and updater service.
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3008"
# Local development may use localhost. Production must set the canonical HTTPS
# origin exactly, for example https://shot.atrishub.com. Request Host headers
# are intentionally not trusted for updater metadata.
SHOT_PUBLIC_BASE_URL="http://localhost:3008"
SHOT_RELEASE_REPO_OWNER=""
SHOT_RELEASE_REPO_NAME="AtrisShot"
SHOT_RELEASE_REPO_ACCESS_TOKEN=""

# User screenshot history, settings, annotations, and credentials do not belong
# in environment files. The packaged app stores them locally.
