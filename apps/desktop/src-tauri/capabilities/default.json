{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum shared AtrisShot runtime permissions",
  "windows": ["main", "overlay", "capture", "editor"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load"
  ]
}
