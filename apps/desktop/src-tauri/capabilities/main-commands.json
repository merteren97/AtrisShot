{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-commands",
  "description": "AtrisShot application commands available to the trusted main window",
  "windows": ["main"],
  "permissions": [
    "allow-authorize-product-access",
    "allow-revoke-product-access",
    "allow-store-session-token",
    "allow-read-session-token",
    "allow-delete-session-token",
    "allow-list-displays",
    "allow-list-shot-history",
    "allow-capture-shot",
    "allow-delete-shot",
    "allow-delete-shots",
    "allow-clear-shot-history",
    "allow-latest-shot",
    "allow-apply-annotations",
    "allow-reveal-shot",
    "allow-copy-shot-path",
    "allow-copy-shot-image",
    "allow-path-exists",
    "allow-window-target-at-cursor",
    "allow-read-shot-data-url",
    "allow-remove-local-data",
    "allow-validate-save-folder",
    "allow-open-storage-folder",
    "allow-save-shortcut",
    "allow-save-overlay-shortcut",
    "allow-show-overlay",
    "allow-set-overlay-stack-size",
    "allow-set-overlay-presentation",
    "allow-hide-overlay",
    "allow-toggle-overlay",
    "allow-show-capture-overlay",
    "allow-hide-capture-overlay",
    "allow-open-main-window",
    "allow-open-editor-window",
    "allow-hide-editor-window",
    "allow-set-tray-locale",
    "allow-restart-application"
  ]
}
