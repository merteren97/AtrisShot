{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-ui",
  "description": "Permissions used only by the primary AtrisShot settings and account UI",
  "windows": ["main"],
  "permissions": [
    "clipboard-manager:allow-write-text",
    "dialog:allow-ask",
    "dialog:allow-open",
    "store:allow-set",
    "store:allow-save"
  ]
}
