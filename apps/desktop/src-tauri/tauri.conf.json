{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AtrisShot",
  "version": "1.0.1",
  "identifier": "com.atris.shot",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3009",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri-export"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AtrisShot",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "editor",
        "title": "AtrisShot Editor",
        "url": "/editor",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "AtrisShot Result",
        "url": "/overlay",
        "width": 304,
        "height": 176,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "capture",
        "title": "AtrisShot Capture",
        "url": "/capture-overlay",
        "width": 1440,
        "height": 900,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://atrishub.com",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:3009 customprotocol: asset:",
        "script-src": "'self' 'unsafe-eval' http://localhost:3009",
        "connect-src": "ipc: http://ipc.localhost http://localhost:3009 ws://localhost:3009 http://127.0.0.1:3000 https://atrishub.com",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost http://localhost:3009 blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "AtrisHub",
    "copyright": "Copyright © 2026 AtrisHub"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://shot.atrishub.com/api/releases/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_PRODUCTION_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
