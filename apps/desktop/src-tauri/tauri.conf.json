{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AtrisShot",
  "version": "0.1.0",
  "identifier": "com.atris.shot",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3009",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri-export"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "AtrisShot", "width": 1120, "height": 720, "minWidth": 900, "minHeight": 600, "resizable": true, "fullscreen": false },
      { "label": "overlay", "title": "AtrisShot Result", "url": "/overlay", "width": 320, "height": 104, "transparent": true, "alwaysOnTop": true, "decorations": false, "shadow": false, "resizable": false, "skipTaskbar": true, "visible": false },
      { "label": "capture", "title": "AtrisShot Capture", "url": "/capture-overlay", "width": 1440, "height": 900, "transparent": true, "alwaysOnTop": true, "decorations": false, "shadow": false, "resizable": false, "skipTaskbar": true, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "AtrisHub",
    "copyright": "Copyright © 2026 AtrisHub"
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://shot.atrishub.com/api/releases/update/{{target}}/{{current_version}}"],
      "pubkey": "REPLACE_WITH_PRODUCTION_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
